{
  "name": "@golddevelopment/virtuagym-node",
  "version": "0.0.9",
  "description": "VirtuaGym api for NodeJS",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": {
    "name": "Gold Development",
    "email": "admin@gold-development.nl",
    "url": "https://gold-development.nl"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gold-development/virtuagym-node"
  },
  "exports": {
    "./models": {
      "import": {
        "types": "./dist/models/index.d.ts",
        "default": "./dist/models/index.js"
      },
      "require": {
        "types": "./dist/models/index.d.cts",
        "default": "./dist/models/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client/index.d.ts",
        "default": "./dist/client/index.js"
      },
      "require": {
        "types": "./dist/client/index.d.cts",
        "default": "./dist/client/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/update-coverage-badge.mjs",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "npm run typecheck && tsup",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
